{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Upload to ESP32",
            "type": "process",
            "command": "python",
            "args": [
                "${workspaceFolder}/scripts/upload_esp32.py",
                "--port",
                "${input:esp32Port}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "esp32Port",
            "type": "promptString",
            "description": "ESP32 serial port",
            "default": "COM10"
        }
    ]
}
